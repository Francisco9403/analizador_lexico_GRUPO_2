package Parser;
import java.util.*;
import java_cup.runtime.*;
import Exception.SyntaxException;
import java.util.ArrayList;
import Lexer.Lexer;
import TablaSimbolo.TablaSimbolo;
import llvm.CodeGeneratorHelper;
import ast.*;
import service.TypeChecker;

class Parser;

parser code {:
    public static TablaSimbolo tablaSimbolos = new TablaSimbolo();

    private int reglaCount = 1; // Contador secuencial
    private java.util.List<String> listaLogs = new java.util.ArrayList<>();

    public void printLog(String regla) {
        // Formateamos con el número de paso (ej: 001. Regla: ...)
        String mensaje = String.format("%03d. Regla aplicada: %s", reglaCount++, regla);
        listaLogs.add(mensaje);
        System.out.println(mensaje);
    }

    public java.util.List<String> getLogs() {
        return listaLogs;
    }

    public void syntax_error(Symbol s){
        // Esto solo imprime un aviso temporal en consola
        System.out.println("Aviso: Error sintáctico cerca de la línea " + (s.left + 1));
    }

    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception{
        // Construimos el mensaje y LANZAMOS la excepción
        String mensaje = "Error en la linea " + (s.left + 1) + " Columna " + s.right + ". Valor simbolo '" + s.value + "' no esperado.";

        // Lanzamos la excepción directamente
        throw new SyntaxException(mensaje);
    }

    public Expresion[] igualarTipos(Expresion e1, Expresion e2) {
            String t1 = e1.getTipoDato();
            String t2 = e2.getTipoDato();

            if ("FLOAT".equals(t1) && "INT".equals(t2)) {
                e2 = new CastIntToFloat(e2); // Casteamos el derecho
            } else if ("INT".equals(t1) && "FLOAT".equals(t2)) {
                e1 = new CastIntToFloat(e1); // Casteamos el izquierdo
            }
            return new Expresion[]{e1, e2};
        }

        public Expresion castearParaAsignacion(Expresion expr, String tipoVariable) {
            if ("FLOAT".equals(tipoVariable) && "INT".equals(expr.getTipoDato())) {
                return new CastIntToFloat(expr);
            }
            return expr;
        }
:};

terminal IF, ELIF, ELSE, WHILE, ALT_WHILE, BREAK, CONTINUE, PRINT;
terminal PROGRAM;
terminal String TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_ARRAY;
terminal String READ_INT, READ_FLOAT, READ_BOOL, CONST_BOOL;
terminal String ID, CTE_INT, CTE_FLOAT, CTE_STR;
terminal OP_SUMA, OP_RESTA, OP_MULT, OP_DIV;
terminal COMP_IGUAL, COMP_DISTINTO, COMP_MAYOR_IGUAL, COMP_MENOR_IGUAL, COMP_MAYOR, COMP_MENOR;
terminal ASIG, AND, OR, NOT;
terminal PAR_A, PAR_C, CORCH_A, CORCH_C, COMA, DOS_PUNTOS;
terminal V_INDENT, V_DEDENT, SUMA_ACUM;
terminal UMENOS;


/* --- DECLARACION DE NO TERMINALES --- */
nonterminal Programa program;
nonterminal String tipo;
nonterminal ArrayList<Nodo> bloque_declaraciones, declaracion;
nonterminal ArrayList<String> lista_ids;
nonterminal ArrayList<Expresion> lista_expresiones;
nonterminal ArrayList<Nodo> bloque, bloque_sentencias, seccion_sentencias, lista_sentencias;
nonterminal ArrayList<Nodo> elif_part, else_part, alt_while_part;
nonterminal Nodo sentencia, sentencia_control;
nonterminal Impresion impresion;
nonterminal If sentencia_if;
nonterminal ArrayList<Nodo> tail_if;
nonterminal While sentencia_while;
nonterminal Expresion expresion, expresionOr, expresionAnd, expresionNot, expresionSumRes, expresionMultDiv, expresionMenosU;
nonterminal SumaAcumulativa sum_acum;
nonterminal Asignacion asignacion;
nonterminal Expresion comparacion, valorLiteral, arreglo_literal, cte_string;

start with program;

/* --------------------------------------------------------
   1. ESTRUCTURA PRINCIPAL DEL PROGRAMA
   -------------------------------------------------------- */
program ::= bloque_declaraciones:bd seccion_sentencias:bs {:
            parser.printLog("Regla 1.0.0 program ::= bloque_declaraciones seccion_sentencias");
            RESULT = new Programa(bd, bs);
        :}
        | seccion_sentencias:bs {:
             parser.printLog("Regla 1.0.1 program ::= seccion_sentencias");
             RESULT = new Programa(new ArrayList<>(), bs);
        :};

/* --------------------------------------------------------
   2. ZONA DE DECLARACION DE VARIABLES
   -------------------------------------------------------- */

seccion_sentencias ::= PROGRAM V_INDENT bloque_sentencias:bs V_DEDENT {:
                      parser.printLog("Regla 1.1.0 seccion_sentencias ::= PROGRAM V_INDENT bloque_sentencias V_DEDENT");
                      RESULT = bs;
                    :}
                    | PROGRAM {:
                      parser.printLog("Regla 1.1.1 seccion_sentencias ::= PROGRAM (Seccion vacia)");
                      RESULT = new ArrayList<Nodo>();
                    :}
                    | /* vacio - Sin sentencias */ {:
                      parser.printLog("Regla 1.1.2 seccion_sentencias ::= ( Sin sección PROGRAM )");
                      RESULT = new ArrayList<Nodo>();
                    :};

bloque_declaraciones ::= bloque_declaraciones:bd declaracion:d {:
                        parser.printLog("Regla 1.2.0 bloque_declaraciones ::= bloque_declaraciones declaracion");
                        bd.addAll(d);
                        RESULT = bd;
                      :}
                      | declaracion:d {:
                        parser.printLog("Regla 1.2.1 bloque_declaraciones ::= declaracion");
                        RESULT = d;
                      :};

declaracion ::= tipo:t DOS_PUNTOS lista_ids:l {:
            parser.printLog("Regla 1.3.0 declaracion ::= tipo:t DOS_PUNTOS lista_ids:l");
            ArrayList<Nodo> decls = new ArrayList<>();
            for(String id : l) {
                if (!tablaSimbolos.exists(id)) {
                    tablaSimbolos.addId(id, "ID");
                    tablaSimbolos.setType(id, t);
                    parser.printLog("Variable declarada: " + id + " de tipo " + t);
                    decls.add(new Declaracion(t, id));
                } else {
                    System.err.println("Error semántico: " + id + " ya existe.");
                }
            }
            RESULT = decls;
        :};

lista_ids ::= lista_ids:l COMA ID:id {:
            parser.printLog("Regla 1.4.0 lista_ids ::= lista_ids COMA ID");
            l.add(id);
            RESULT = l;
        :}
        | ID:id {:
            parser.printLog("Regla 1.4.1 lista_ids ::= ID");
            ArrayList<String> lista = new ArrayList<>();
            lista.add(id);
            RESULT = lista;
        :};

tipo ::= TYPE_INT {: parser.printLog("Regla 1.5.0 tipo ::= TYPE_INT"); RESULT = "INT"; :}
       | TYPE_FLOAT {: parser.printLog("Regla 1.5.1 tipo ::= TYPE_FLOAT"); RESULT = "FLOAT"; :}
       | TYPE_BOOL {: parser.printLog("Regla 1.5.2 tipo ::= TYPE_BOOL"); RESULT = "BOOL"; :}
       | TYPE_ARRAY CORCH_A CTE_INT:size CORCH_C {:
            parser.printLog("Regla 1.5.3 tipo ::= TYPE_ARRAY [ CTE_INT ]");
            RESULT = "FLOAT_ARRAY[" + size + "]";
       :};

/* --------------------------------------------------------
   3. ZONA DE SENTENCIAS (Cuerpo del programa)
   -------------------------------------------------------- */

bloque_sentencias ::= bloque_sentencias:bs sentencia:s {:
                   parser.printLog("Regla 2.0.0 bloque_sentencias ::= bloque_sentencias sentencia");
                   bs.add(s); RESULT = bs;
                   :}
                 | sentencia:s {:
                   parser.printLog("Regla 2.0.1 bloque_sentencias ::= sentencia");
                   ArrayList<Nodo> lista = new ArrayList<>(); lista.add(s); RESULT = lista;
                 :};

sentencia ::= asignacion:a {: parser.printLog("Regla 2.1.0 sentencia ::= asignacion"); RESULT= a; :}
            | impresion:i {: parser.printLog("Regla 2.1.1 sentencia ::= impresion"); RESULT= i; :}
            | sentencia_if:si {: parser.printLog("Regla 2.1.2 sentencia ::= sentencia_if"); RESULT= si; :}
            | sentencia_while:sw {: parser.printLog("Regla 2.1.3 sentencia ::= sentencia_while"); RESULT= sw; :}
            | sentencia_control:sc {: parser.printLog("Regla 2.1.4 sentencia ::= sentencia_control"); RESULT= sc; :};

asignacion ::= ID:id ASIG expresionOr:e {:
    if (!Parser.tablaSimbolos.exists(id)) {
        throw new Exception("Error: Variable '" + id + "' no declarada.");
    }

    String tipoVar = Parser.tablaSimbolos.getType(id);

    if (!TypeChecker.esAsignacionValida(tipoVar, e.getTipoDato())) {
        throw new Exception("Error de tipos: no se puede asignar " + e.getTipoDato() + " a " + id + " (" + tipoVar + ")");
    }

    Expresion exprCasteada = parser.castearParaAsignacion(e, tipoVar);
    Asignacion nodo = new Asignacion(new Identificador(id), exprCasteada);

    nodo.setTipoDato(tipoVar); // Decoramos el nodo
    RESULT = nodo;
:};

impresion ::= PRINT PAR_A expresionOr:e PAR_C {:
                parser.printLog("Regla 2.4.0 impresion ::= PRINT PAR_A expresionOr PAR_C");
                RESULT = new Impresion(e);
              :}
            | PRINT PAR_A cte_string:s COMA expresionOr:e PAR_C {:
                parser.printLog("Regla 2.4.1 impresion ::= PRINT PAR_A CTE_STR COMA expresionOr PAR_C");
                String textoLimpio = ((ast.NodoHoja)s).getValor().toString();
                RESULT = new Impresion(textoLimpio, e);
            :}
            | PRINT PAR_A cte_string:s PAR_C {:
                parser.printLog("Regla 2.4.2 impresion ::= PRINT PAR_A CTE_STR PAR_C");
                String textoLimpio = ((ast.NodoHoja)s).getValor().toString();
                RESULT = new Impresion(textoLimpio);
            :};

bloque ::= V_INDENT lista_sentencias:ls V_DEDENT {:
         parser.printLog("Regla 2.5.0 bloque ::= V_INDENT lista_sentencias V_DEDENT");
         RESULT = ls;
         :};

lista_sentencias ::= lista_sentencias:ls sentencia:s{:
                  parser.printLog("Regla 2.6.0 lista_sentencias ::= lista_sentencias sentencia");
                  ls.add(s); RESULT= ls;
                  :}
                  | sentencia:s {:
                  parser.printLog("Regla 2.6.1 lista_sentencias ::= sentencia");
                  ArrayList<Nodo> ls = new ArrayList<>(); ls.add(s); RESULT = ls;
                  :};

sentencia_control ::= BREAK {:
                    parser.printLog("Regla 2.7.0 sentencia_control ::= BREAK");
                    RESULT = new NodoControl("BREAK");
                    :}
                    | CONTINUE {:
                    parser.printLog("Regla 2.7.1 sentencia_control ::= CONTINUE");
                    RESULT = new NodoControl("CONTINUE");
                    :};

sentencia_if ::= IF expresionOr:c bloque:b elif_part:el else_part:es {:
                  parser.printLog("Regla 2.8.0 sentencia_if ::= IF expresionOr bloque elif_part else_part (Reescritura Nativa)");

                  // 1. Empezamos con el bloque ELSE final original
                  List<Nodo> bloqueElseActual = es;

                  // 2. Recorremos los ELIFs de atrás para adelante (Fold Right)
                  for (int i = el.size() - 1; i >= 0; i--) {
                      If nodoElif = (If) el.get(i);

                      // El ELSE de este ELIF es lo que veníamos arrastrando
                      nodoElif.setBloqueElse(bloqueElseActual);

                      // Ahora ESTE nodo ELIF completo se convierte en el bloque ELSE del nivel superior
                      bloqueElseActual = new ArrayList<>();
                      bloqueElseActual.add(nodoElif);
                  }

                  // 3. Finalmente armamos el IF raíz, pasándole la muñeca rusa que armamos como ELSE
                  RESULT = new If(c, b, bloqueElseActual);
               :};

sentencia_while ::= WHILE expresionOr:c bloque:b alt_while_part:aw {:
                   parser.printLog("Regla 2.9.0 sentencia_while ::= WHILE expresionOr bloque alt_while_part");
                   RESULT = new While(c, b, aw);
               :};

elif_part ::= elif_part:el ELIF expresionOr:c bloque:b {:
             parser.printLog("Regla 2.10.0 elif_part ::= elif_part ELIF expresionOr bloque");
             // Guardamos un IF temporal sin ELSE (se lo inyectamos arriba en sentencia_if)
             el.add(new If(c, b, new ArrayList<>()));
             RESULT = el;
            :}
            | /* vacio */ {:
             parser.printLog("Regla 2.10.1 elif_part ::= (vacio)");
             RESULT = new ArrayList<Nodo>();
            :};

else_part ::= ELSE bloque:b {:
             parser.printLog("Regla 2.11.0 else_part ::= ELSE bloque");
             RESULT = b;
            :}
            | /* vacio */ {:
             parser.printLog("Regla 2.11.1 else_part ::= (vacio)");
             RESULT = new ArrayList<Nodo>();
            :};

alt_while_part ::= alt_while_part:aw ALT_WHILE expresionOr:c bloque:b {:
                  parser.printLog("Regla 2.12.0 alt_while_part ::= alt_while_part ALT_WHILE expresionOr bloque");
                  aw.add(new While(c, b, new ArrayList<>()));
                  RESULT = aw;
                 :}
                 | /* vacio */ {:
                  parser.printLog("Regla 2.12.1 alt_while_part ::= (vacio)");
                  RESULT = new ArrayList<Nodo>();
                 :};

/* --------------------------------------------------------
   4. EXPRESIONES Y MATEMATICAS
   -------------------------------------------------------- */

expresionOr::= expresionAnd:ea OR expresionOr:eo {:
              parser.printLog("Regla 3.0.0 expresionOr ::= expresionAnd OR expresionOr");
              RESULT = new OperacionLogica("||", ea, eo);
            :}
            | expresionAnd:ea {:
              parser.printLog("Regla 3.0.1 expresionOr ::= expresionAnd");
              RESULT = ea;
            :};

expresionAnd::= expresionNot:en AND expresionAnd:ea {:
              parser.printLog("Regla 3.1.0 expresionAnd ::= expresionNot AND expresionAnd");
              RESULT = new OperacionLogica("&&", en, ea);
            :}
            | expresionNot:en {:
              parser.printLog("Regla 3.1.1 expresionAnd ::= expresionNot");
              RESULT = en;
            :};

expresionNot ::= NOT expresionNot:en {:
               parser.printLog("Regla 3.2.0 expresionNot ::= NOT expresionNot");
               RESULT = new OperacionUnaria("!", en);
             :}
             | comparacion:c {:
               parser.printLog("Regla 3.2.1 expresionNot ::= comparacion");
               RESULT= c;
             :};

expresionSumRes ::= expresionSumRes:e1 OP_SUMA expresionMultDiv:e2 {:
                    parser.printLog("Regla: expresionSumRes ::= expresionSumRes OP_SUMA expresionMultDiv");
                    String tipoRes = TypeChecker.getTipoResultadoOperacion(e1.getTipoDato(), e2.getTipoDato());
                    if (tipoRes.equals("ERROR")) {
                        throw new Exception("Error de tipos: No se puede sumar " + e1.getTipoDato() + " con " + e2.getTipoDato());
                    }
                    Expresion[] operandos = parser.igualarTipos(e1, e2);
                    OperacionAritmetica nodoSuma = new OperacionAritmetica("+", operandos[0], operandos[1]);
                    nodoSuma.setTipoDato(tipoRes);
                    RESULT = nodoSuma;
                  :}
                  | expresionSumRes:e1 OP_RESTA expresionMultDiv:e2 {:
                    parser.printLog("Regla: expresionSumRes ::= expresionSumRes OP_RESTA expresionMultDiv");

                    String tipoRes = TypeChecker.getTipoResultadoOperacion(e1.getTipoDato(), e2.getTipoDato());
                    if (tipoRes.equals("ERROR")) {
                        throw new Exception("Error de tipos: No se puede restar " + e1.getTipoDato() + " con " + e2.getTipoDato());
                    }
                    Expresion[] operandos = parser.igualarTipos(e1, e2);
                    OperacionAritmetica nodoResta = new OperacionAritmetica("-",operandos[0], operandos[1]);
                    nodoResta.setTipoDato(tipoRes);
                    RESULT = nodoResta;
                  :}
                | expresionMultDiv:em {:
                parser.printLog("Regla 3.3.2 expresionSumRes ::= expresionMultDiv");
                RESULT = em;
                :};

expresionMultDiv ::= expresionMultDiv:e1 OP_MULT expresionMenosU:e2 {:
                    parser.printLog("Regla: expresionMultDiv ::= expresionMultDiv OP_MULT expresionMenosU");

                    String tipoRes = TypeChecker.getTipoResultadoOperacion(e1.getTipoDato(), e2.getTipoDato());
                    if (tipoRes.equals("ERROR")) {
                        throw new Exception("Error de tipos: No se puede multiplicar " + e1.getTipoDato() + " con " + e2.getTipoDato());
                    }
                    Expresion[] operandos = parser.igualarTipos(e1, e2);
                    OperacionAritmetica nodo = new OperacionAritmetica("*",operandos[0], operandos[1]);
                    nodo.setTipoDato(tipoRes);
                    RESULT = nodo;
                  :}
                  | expresionMultDiv:e1 OP_DIV expresionMenosU:e2 {:
                    parser.printLog("Regla: expresionMultDiv ::= expresionMultDiv OP_DIV expresionMenosU");

                    String tipoRes = TypeChecker.getTipoResultadoOperacion(e1.getTipoDato(), e2.getTipoDato());
                    if (tipoRes.equals("ERROR")) {
                        throw new Exception("Error de tipos: No se puede dividir " + e1.getTipoDato() + " con " + e2.getTipoDato());
                    }
                    Expresion[] operandos = parser.igualarTipos(e1, e2);
                    OperacionAritmetica nodo = new OperacionAritmetica("/", operandos[0], operandos[1]);
                    nodo.setTipoDato(tipoRes);
                    RESULT = nodo;  :}
                 | expresionMenosU:emu {:
                 parser.printLog("Regla 3.4.2 expresionMultDiv ::= expresionMenosU");
                 RESULT = emu;
                 :};

comparacion ::= expresionSumRes:es1 COMP_IGUAL expresionSumRes:es2 {:
              parser.printLog("Regla 3.5.0 comparacion ::= expresionSumRes COMP_IGUAL expresionSumRes");
              Expresion[] operandos = parser.igualarTipos(es1, es2);
              OperacionComparar nodoIgual = new OperacionComparar("==", operandos[0], operandos[1]);
              nodoIgual.setTipoDato("BOOL");
              RESULT = nodoIgual;
              :}
              | expresionSumRes:es1 COMP_DISTINTO expresionSumRes:es2 {:
              parser.printLog("Regla 3.5.1 comparacion ::= expresionSumRes COMP_DISTINTO expresionSumRes");
              Expresion[] operandos = parser.igualarTipos(es1, es2);
              OperacionComparar nodoDistinto = new OperacionComparar("!=", operandos[0], operandos[1]);
              nodoDistinto.setTipoDato("BOOL");
              RESULT = nodoDistinto;
              :}
              | expresionSumRes:es1 COMP_MAYOR expresionSumRes:es2 {:
              parser.printLog("Regla 3.5.2 comparacion ::= expresionSumRes COMP_MAYOR expresionSumRes");
              Expresion[] operandos = parser.igualarTipos(es1, es2);
              OperacionComparar nodoMayor = new OperacionComparar(">", operandos[0], operandos[1]);
              nodoMayor.setTipoDato("BOOL");
              RESULT = nodoMayor;
              :}
              | expresionSumRes:es1 COMP_MENOR expresionSumRes:es2 {:
              parser.printLog("Regla 3.5.3 comparacion ::= expresionSumRes COMP_MENOR expresionSumRes");
              Expresion[] operandos = parser.igualarTipos(es1, es2);
              OperacionComparar nodoMenor = new OperacionComparar("<", operandos[0], operandos[1]);
              nodoMenor.setTipoDato("BOOL");
              RESULT = nodoMenor;
              :}
              | expresionSumRes:es1 COMP_MAYOR_IGUAL expresionSumRes:es2 {:
              parser.printLog("Regla 3.5.4 comparacion ::= expresionSumRes COMP_MAYOR_IGUAL expresionSumRes");
              Expresion[] operandos = parser.igualarTipos(es1, es2);
              OperacionComparar nodoMayorIgual = new OperacionComparar(">=", operandos[0], operandos[1]);
              nodoMayorIgual.setTipoDato("BOOL");
              RESULT = nodoMayorIgual;
              :}
              | expresionSumRes:es1 COMP_MENOR_IGUAL expresionSumRes:es2 {:
              parser.printLog("Regla 3.5.5 comparacion ::= expresionSumRes COMP_MENOR_IGUAL expresionSumRes");
              Expresion[] operandos = parser.igualarTipos(es1, es2);
              OperacionComparar nodoMenorIgual = new OperacionComparar("<=", operandos[0], operandos[1]);
              nodoMenorIgual.setTipoDato("BOOL");
              RESULT = nodoMenorIgual;
              :}
              | expresionSumRes:es {:
              parser.printLog("Regla 3.5.6 comparacion ::= expresionSumRes");
              RESULT = es;
              :};

expresionMenosU ::= OP_RESTA expresionMenosU:e {:
                parser.printLog("Regla 3.6.0 expresionMenosU ::= OP_RESTA expresionMenosU");
                OperacionUnaria nodo = new OperacionUnaria("-", e);
                nodo.setTipoDato(e.getTipoDato());
                RESULT = nodo;
                :} %prec UMENOS
                | expresion:e {:
                parser.printLog("Regla 3.6.1 expresionMenosU ::= expresion");
                RESULT = e;
                :};

/* --- Dentro de la sección de EXPRESIONES --- */
expresion ::= PAR_A expresionOr:e PAR_C {:
            parser.printLog("Regla 3.7.0 expresion ::= PAR_A expresionOr PAR_C");
            RESULT = e;
            :}
            | ID:id {:
        parser.printLog("Regla 3.7.1 expresion ::= ID");
        if (!Parser.tablaSimbolos.exists(id)) {
            throw new Exception("Error semántico: Variable '" + id + "' no declarada.");
        }
        Identificador nodo = new Identificador(id);
        nodo.setTipoDato(Parser.tablaSimbolos.getType(id));
        RESULT = nodo;
        :}
            | valorLiteral:vl {:
            parser.printLog("Regla 3.7.2 expresion ::= valorLiteral");
            RESULT = vl;
            :}
    | ID:id CORCH_A expresionOr:e CORCH_C {:
    parser.printLog("Regla: expresion ::= ID [ expresionOr ]");

    if (!Parser.tablaSimbolos.exists(id)) {
        throw new Exception("Error semántico: Variable '" + id + "' no declarada.");
    }

    // 2. Validar que la variable sea realmente un arreglo
    String tipoArreglo = Parser.tablaSimbolos.getType(id); // Ej: "FLOAT_ARRAY[10]"
    if (!tipoArreglo.startsWith("FLOAT_ARRAY")) {
        throw new Exception("Error semántico: '" + id + "' no es un arreglo indexable.");
    }
    if (!e.getTipoDato().equals("INT")) {
        throw new Exception("Error semántico: El índice del arreglo '" + id + "' debe ser una expresión entera. Se recibió: " + e.getTipoDato());
    }
    AccesoArreglo nodo = new AccesoArreglo(id, e);
    nodo.setTipoDato("FLOAT");
    RESULT = nodo;
:}
            | READ_INT PAR_A PAR_C   {:
            parser.printLog("Regla 3.7.4 expresion ::= READ_INT PAR_A PAR_C");
            RESULT = new Read("INT");
            :}
            | READ_FLOAT PAR_A PAR_C {:
            parser.printLog("Regla 3.7.5 expresion ::= READ_FLOAT PAR_A PAR_C");
            RESULT = new Read("FLOAT");
            :}
            | READ_BOOL PAR_A PAR_C  {:
            parser.printLog("Regla 3.7.6 expresion ::= READ_BOOL PAR_A PAR_C");
            RESULT = new Read("BOOL");
            :}
            | sum_acum:sm {:
            parser.printLog("Regla 3.7.7 expresion ::= sum_acum");
            RESULT = sm;
            :};

/* --- Dentro de la sección de valorLiteral --- */
valorLiteral ::= CTE_INT:n {:
                parser.printLog("Regla 3.8.0 valorLiteral ::= CTE_INT");
                NodoHoja nodo = new NodoHoja(n);
                nodo.setTipoDato("INT");
                RESULT = nodo;
            :}| CTE_FLOAT:f {:
                parser.printLog("Regla 3.8.1 valorLiteral ::= CTE_FLOAT");
                NodoHoja nodo = new NodoHoja(f);
                nodo.setTipoDato("FLOAT");
                RESULT = nodo;
            :}| CONST_BOOL:b {:
              parser.printLog("Regla 3.8.2 valorLiteral ::= CONST_BOOL");
              NodoHoja nodo = new NodoHoja(b);
              nodo.setTipoDato("BOOL");
              RESULT = nodo;
              :}
              | arreglo_literal:a {:
              parser.printLog("Regla 3.8.3 valorLiteral ::= arreglo_literal"); RESULT = a;
              :}
              | cte_string:s {:
              parser.printLog("Regla 3.8.4 valorLiteral ::= cte_string"); RESULT = s;
              :};

arreglo_literal ::= CORCH_A lista_expresiones:le CORCH_C {:
                    parser.printLog("Regla 3.12.0 arreglo_literal ::= CORCH_A lista_expresiones CORCH_C");
                    Arreglo nodo = new Arreglo(le);
                    nodo.setTipoDato("FLOAT_ARRAY");
                    RESULT = nodo;
                  :}
                | CORCH_A CORCH_C {:
                    Arreglo nodo = new Arreglo(new ArrayList<>());
                    nodo.setTipoDato("FLOAT_ARRAY");
                    RESULT = nodo;
                  :};

cte_string ::= CTE_STR:s {:
             parser.printLog("Regla 3.9.0 cte_string ::= CTE_STR");
             Parser.tablaSimbolos.addConstant("_" + s, "CTE_STR", s, String.valueOf(s.length()));
             NodoHoja nodo = new NodoHoja("\"" + s + "\"");
             nodo.setTipoDato("STRING");
             RESULT = nodo;
            :};

sum_acum ::= SUMA_ACUM PAR_A expresionOr:limite COMA ID:idArreglo PAR_C {:
            parser.printLog("Regla 3.10.1 SUMA_ACUM PAR_A expresionOr COMA ID PAR_C");

            if (!Parser.tablaSimbolos.exists(idArreglo)) {
                throw new Exception("Error semántico: Variable '" + idArreglo + "' no declarada.");
            }

            String tipoArreglo = Parser.tablaSimbolos.getType(idArreglo);
            if (!tipoArreglo.startsWith("FLOAT_ARRAY")) {
                 throw new Exception("Error semántico: Suma Acumulativa requiere un float_array.");
            }

            Identificador nodoArr = new Identificador(idArreglo);
            nodoArr.setTipoDato(tipoArreglo);

            RESULT = new SumaAcumulativa(limite, nodoArr, idArreglo);
          :}
          | SUMA_ACUM PAR_A expresionOr:limite COMA arreglo_literal:al PAR_C {:
            parser.printLog("Regla 3.10.0 SUMA_ACUM PAR_A expresionOr COMA arreglo_literal PAR_C");
            // NOTA: Para el arreglo literal generamos una variable temporal en memoria
            String idTemp = "_arr_temp_" + CodeGeneratorHelper.getNewLabel();
            RESULT = new SumaAcumulativa(limite, al, idTemp);
          :};

/* --------------------------------------------------------
   5. ARREGLOS Y LISTAS
   -------------------------------------------------------- */

lista_expresiones ::= lista_expresiones:li COMA expresionOr:e {:
                    parser.printLog("Regla 3.11.0 lista_expresiones ::= lista_expresiones COMA expresionOr");
                    li.add(e);
                    RESULT = li;
                    :}
                    | expresionOr:e {:
                    parser.printLog("Regla 3.11.1 lista_expresiones ::= expresionOr");
                    ArrayList<Expresion> le = new ArrayList<>();
                    le.add(e);
                    RESULT = le;
                    :};